# RentReady API — server-side environment variables.
# The backend reads these from the process environment, never from a file:
#   production — Vercel → Project → Settings → Environment Variables
#   local runs — export them in the terminal before starting uvicorn
# This file is a template documenting the names and shapes; nothing loads it,
# so copying it to .env.local will NOT reach the Python backend.
# The browser NEVER receives these — only the FastAPI backend reads them.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Optional: frontend origin allowed by CORS during local dev only.
APP_ORIGIN=http://localhost:5173